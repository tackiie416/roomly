# Copiar a .env.local y rellenar con valores reales.
# .env.local NUNCA se commitea (ver .gitignore).
# Detalle de cada variable en docs/ENVIRONMENT.md

# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY= # server-only — NUNCA exponer al cliente

# ===== Sitio =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== Mapas (pendiente confirmar Mapbox vs. Google Maps) =====
NEXT_PUBLIC_MAPBOX_TOKEN=

# ===== Email transaccional =====
RESEND_API_KEY=

# ===== Analítica =====
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ===== Pagos — Fase V4, NO usado en el MVP =====
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
